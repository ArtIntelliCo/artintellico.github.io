---
import { partners } from '../data/partners';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
---

<section id="partners" class="border-y border-brand-navy/10 bg-brand-navy/[0.03] py-14">
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="text-center text-sm font-semibold uppercase tracking-[0.2em] text-brand-navy/60">
      {dict.partners.heading}
    </h2>

    <ul class="mt-10 flex flex-wrap items-center justify-center gap-x-14 gap-y-10">
      {
        partners.map((partner) => (
          <li
            class="partner flex items-center justify-center"
            style={`--partner-color: ${partner.color}; --partner-size: ${partner.size}px`}
          >
            <span class="partner-logo flex h-12 items-center text-brand-navy/45 transition-colors duration-200">
              <Fragment set:html={partner.logo} />
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .partner-logo :global(svg) {
    width: var(--partner-size);
    height: var(--partner-size);
    fill: currentColor;
  }

  .partner:hover .partner-logo {
    color: var(--partner-color);
  }
</style>
