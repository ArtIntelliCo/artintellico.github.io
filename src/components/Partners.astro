---
import { partners } from '../data/partners';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
---

<section id="partners" class="border-y border-brand-navy/10 bg-brand-navy/[0.03] py-14">
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="text-center text-sm font-semibold uppercase tracking-[0.2em] text-brand-navy/60">
      {dict.partners.heading}
    </h2>

    <ul class="mt-8 flex flex-wrap items-center justify-center gap-x-12 gap-y-6">
      {
        partners.map((partner) => (
          <li class="text-xl font-bold tracking-tight text-brand-navy/70 sm:text-2xl">{partner}</li>
        ))
      }
    </ul>
  </div>
</section>
