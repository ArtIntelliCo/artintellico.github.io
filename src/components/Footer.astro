---
import { company } from '../data/company';
import { t, type Locale } from '../i18n';
import { variantIds, variantName, variantPath, variants } from '../variants';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const year = new Date().getFullYear();

const address = company.address[locale];

// Реквизиты собираются в одну строку; незаполненные поля просто выпадают.
const legalParts = [company.legalName[locale], address && `${dict.footer.addressLabel}: ${address}`].filter(Boolean);
---

<footer class="border-t border-brand-navy/10 py-8 text-center">
  <p class="mx-auto max-w-3xl px-4 text-base font-medium text-brand-navy">{dict.footer.slogan}</p>

  <nav aria-label={dict.footer.variants} class="mx-auto mt-6 max-w-4xl px-4">
    <p class="text-xs uppercase tracking-wide text-brand-navy/50">{dict.footer.variants}</p>
    <ul class="mt-2 flex flex-wrap justify-center gap-x-4 gap-y-1 text-sm">
      {
        variantIds.map((id) => (
          <li>
            {id === 'classic' ? (
              <span aria-current="page" class="font-semibold text-brand-blue">
                {variantName(id, locale)}
              </span>
            ) : (
              <a href={variantPath(id, locale)} class="text-brand-navy/70 transition hover:text-brand-blue">
                {variantName(id, locale)}
                <span class="text-brand-navy/40"> · {variants[id].year}</span>
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </nav>

  <p class="mt-6 text-sm text-brand-navy/60">© {year} ArtIntelliCo. {dict.footer.rights}</p>

  <p class="mx-auto mt-3 max-w-3xl px-4 text-[11px] leading-relaxed text-brand-navy/35">
    {legalParts.join(' · ')}
  </p>
</footer>
