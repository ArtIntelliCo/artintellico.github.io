---
import { htmlLang, localePath, t, type Locale } from '../i18n';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SeoHead from '../components/SeoHead.astro';
import AicRuntime from '../components/AicRuntime.astro';
import VariantBar from '../components/VariantBar.astro';
import barCss from '../variants/bar.css?raw';
import '../styles/global.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <SeoHead locale={locale} paths={localePath} />
    <style is:inline set:html={barCss}></style>

    <AicRuntime variant="classic" />
    {/* DOS-версия и её темы берут язык из aic-lang: переход отсюда откроет их на языке этой страницы. */}
    <script is:inline define:vars={{ locale }}>
      try {
        localStorage.setItem('aic-lang', locale);
      } catch {
        /* хранилище недоступно */
      }
    </script>
  </head>
  <body class="font-sans text-brand-navy antialiased" style="padding-bottom: var(--aic-bar)">
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-W3Z644V"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"></iframe>
    </noscript>

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2"
      >{dict.nav.skipToContent}</a
    >

    <Header locale={locale} />

    <main id="main">
      <slot />
    </main>

    <Footer locale={locale} />

    <VariantBar locale={locale} variant="classic" />
  </body>
</html>
